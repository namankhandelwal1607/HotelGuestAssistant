# Hotel Guest Assistant Backend Environment Variables

# Port for Express API server
PORT=4000

# Groq API Key (required for LLM tool calling in production)
# Get your free/fast API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (default: llama-3.3-70b-versatile, fallback: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000
